DATABASE_URL=postgres://paperclip:paperclip@localhost:5432/paperclip
PORT=3100
SERVE_UI=false

# ZHC Auth Bridge — set this to the same GATING_SESSION_SECRET used by zhc-nextjs
# When set, wallet-authenticated ZHC members are auto-provisioned into Paperclip
ZHC_GATING_SESSION_SECRET=

# ZHC Company Session — Privy-backed company session auth
# When COMPANY_SESSION_SECRET is set in authenticated mode, company session
# replaces BetterAuth for session resolution
COMPANY_SESSION_SECRET=
COMPANY_SESSION_COOKIE_DOMAIN=.zhcinstitute.com
COMPANY_APP_ALLOWED_PRIVY_USER_IDS=
COMPANY_APP_ALLOWED_EMAILS=
VITE_ZHC_SITE_URL=https://zhcinstitute.com

# Bankr Token Launch — partner API for token deployment
BANKR_PARTNER_KEY=
BANKR_API_BASE_URL=https://api.bankr.bot
BANKR_APP_BASE_URL=https://bankr.bot
BANKR_API_TIMEOUT_MS=20000
